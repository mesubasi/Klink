# ==============================================================================
# KLINK URL SHORTENER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_NAME=klinkdb
DATABASE_USERNAME=klink_admin
DATABASE_PASSWORD=your_secure_postgres_password_here
DATABASE_PORT=5432

# Redis Configuration (Cache & Rate Limiting)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration (Asynchronous Analytics Queue)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=klink_mq
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# Security & Authentication (JWT Secret - Minimum 256-bit Base64)
JWT_SECRET=your_super_secret_base64_256bit_key_here
JWT_EXPIRATION_MS=86400000

# Application Domain & URLs
APP_DOMAIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Threat & Phishing Security Scanner APIs (Optional)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_DOMAIN=http://localhost:8080
PORT=3000

# First platform admin. Used only while no admin account exists; demo accounts are never created in production.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email (verification, password reset, workspace invitations)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Sender shown on outgoing mail (defaults to the SMTP username when that is an email address)
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=true
FRONTEND_INVITE_URL=https://klink.to/invite/%s
FRONTEND_VERIFY_URL=https://klink.to/verify-email/%s
FRONTEND_RESET_URL=https://klink.to/reset-password/%s

# Plan limits for new workspaces (0 = unlimited). Platform admins can change each customer's limits.
QUOTA_DEFAULT_MAX_MEMBERS=0
QUOTA_DEFAULT_MAX_LINKS=0
QUOTA_MAX_WORKSPACES_PER_USER=5
SELF_SERVICE_WORKSPACES=true
