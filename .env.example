# ==============================================================================
# KLINK URL SHORTENER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Bu dosyayı .env olarak kopyalayıp kendi ortamınıza göre güncelleyiniz:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Genel Sunucu ve Domain Ayarları
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_DOMAIN=https://klink.to
FRONTEND_PREVIEW_URL=https://klink.to/preview/%s

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing) İzinleri (Virgülle ayrılmış)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://klink.to,https://app.klink.to,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Güvenlik & JWT (JSON Web Token) Yapılandırması
# DİKKAT: Üretim ortamında kesinlikle en az 256-bit güçlü rastgele anahtar kullanın!
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. PostgreSQL Veritabanı Yapılandırması
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=klinkdb
DATABASE_USERNAME=klink_admin
DATABASE_PASSWORD=klink_secret_password
DATABASE_URL=jdbc:postgresql://postgres:5432/klinkdb?sslmode=prefer
HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 5. Redis Önbellek (Cache & Rate Limiting) Yapılandırması
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. RabbitMQ Mesaj Kuyruğu (Asenkron Tıklama & Analitik) Yapılandırması
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=klink_mq
RABBITMQ_PASSWORD=klink_mq_pass

# ------------------------------------------------------------------------------
# 7. Hız Sınırlama (Rate Limiting)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 8. Güvenlik & Zararlı Yazılım / Oltalama Tarayıcıları (Opsiyonel API Anahtarları)
# ------------------------------------------------------------------------------
SECURITY_SCANNER_ENABLED=true
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
