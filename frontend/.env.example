# ==============================================================================
# KLINK NEXT.JS FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Bu dosyayı 'frontend/.env.local' olarak kopyalayınız:
#   cp .env.example .env.local
# ==============================================================================

# Backend API Adresi (İstemci / Tarayıcı Tarafından Erişilecek URL)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Uygulama Alan Adı (Kısaltılmış linklerin gösterimi için)
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000
